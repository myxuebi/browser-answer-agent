{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_appDescription__",
  "version": "0.6.0",
  "author": "myxuebi",
  "homepage_url": "https://github.com/myxuebi/browser-answer-agent",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "storage",
    "sidePanel",
    "contextMenus",
    "offscreen"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "default_locale": "zh_CN"
}
